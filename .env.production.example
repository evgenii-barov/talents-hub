# Copy this file to .env.production and replace every replace-me value.
# Run: python scripts/production_preflight.py .env.production

SITE_ADDRESS=http://localhost
WWW_SITE_ADDRESS=http://www.localhost
ADMIN_SITE_ADDRESS=http://admin.localhost
ANALYTICS_SITE_ADDRESS=http://insights.localhost
PUBLIC_SITE_URL=http://localhost
PUBLIC_API_URL=/api

POSTGRES_DB=talents_hub
POSTGRES_USER=talents_hub
POSTGRES_PASSWORD=replace-me-with-a-random-database-password
REDIS_PASSWORD=replace-me-with-a-random-redis-password

DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=replace-me-with-at-least-50-random-characters
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,admin.localhost
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost,http://admin.localhost
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SESSION_COOKIE_SECURE=false
DJANGO_CSRF_COOKIE_SECURE=false
DJANGO_SECURE_HSTS_SECONDS=0
DATABASE_URL=postgresql://talents_hub:replace-me-with-a-random-database-password@db:5432/talents_hub
REDIS_URL=redis://:replace-me-with-a-random-redis-password@redis:6379/1
CELERY_BROKER_URL=redis://:replace-me-with-a-random-redis-password@redis:6379/0
CELERY_RESULT_BACKEND=redis://:replace-me-with-a-random-redis-password@redis:6379/0
FRONTEND_URL=http://localhost
ENABLE_API_DOCS=false

DRF_ANON_THROTTLE_RATE=120/minute
DRF_USER_THROTTLE_RATE=600/minute
DRF_AUTH_THROTTLE_RATE=10/minute
DRF_ACCOUNT_EMAIL_THROTTLE_RATE=5/hour

# Yandex Cloud Postbox SESv2-compatible HTTPS API.
DJANGO_EMAIL_BACKEND=config.email_backends.YandexPostboxEmailBackend
DEFAULT_FROM_EMAIL=Talents Hub <noreply@talents-hub.online>
YANDEX_POSTBOX_ACCESS_KEY_ID=replace-me-with-static-access-key-id
YANDEX_POSTBOX_SECRET_KEY=replace-me-with-static-secret-key
YANDEX_POSTBOX_ENDPOINT=https://postbox.cloud.yandex.net
YANDEX_POSTBOX_REGION=ru-central1
YANDEX_POSTBOX_CONFIGURATION_SET=
EMAIL_TIMEOUT=15

USE_S3=false
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION_NAME=

# Foreign OAuth is disabled by default in production. Enable only after a compliance review.
SOCIAL_AUTH_ENABLED=false
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.01
SENTRY_PROFILES_SAMPLE_RATE=0.0

# Self-hosted GlitchTip (Sentry-compatible error tracking).
GLITCHTIP_DOMAIN=http://errors.localhost
GLITCHTIP_ALLOWED_HOSTS=errors.localhost
GLITCHTIP_CSRF_TRUSTED_ORIGINS=http://errors.localhost
GLITCHTIP_SECRET_KEY=replace-me-with-at-least-50-random-characters
GLITCHTIP_POSTGRES_DB=glitchtip
GLITCHTIP_POSTGRES_USER=glitchtip
GLITCHTIP_POSTGRES_PASSWORD=replace-me-with-a-random-glitchtip-database-password
GLITCHTIP_DATABASE_URL=postgresql://glitchtip:replace-me-with-a-random-glitchtip-database-password@glitchtip-db:5432/glitchtip
GLITCHTIP_DEFAULT_FROM_EMAIL=errors@localhost

# Self-hosted Umami product analytics. Create the website after the first start, then paste its ID
# into UMAMI_WEBSITE_ID and rebuild the frontend. Analytics remains disabled while the ID is empty.
UMAMI_POSTGRES_DB=umami
UMAMI_POSTGRES_USER=umami
UMAMI_POSTGRES_PASSWORD=replace-me-with-a-random-umami-database-password
UMAMI_DATABASE_URL=postgresql://umami:replace-me-with-a-random-umami-database-password@umami-db:5432/umami
UMAMI_APP_SECRET=replace-me-with-at-least-64-random-characters
UMAMI_TWO_FACTOR_ENCRYPTION_KEY=replace-me-with-a-64-character-hex-key
UMAMI_SCRIPT_URL=http://insights.localhost/th.js
UMAMI_WEBSITE_ID=

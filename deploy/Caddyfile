{$WWW_SITE_ADDRESS} {
	redir {$PUBLIC_SITE_URL}{uri} permanent
}

{$SITE_ADDRESS} {
	encode zstd gzip

	handle_path /media/* {
		root * /srv/media
		file_server
	}

	@legacy_admin path /admin /admin/*
	handle @legacy_admin {
		respond "Not Found" 404
	}

	@backend path /api/* /accounts/* /ws/*
	handle @backend {
		reverse_proxy backend:8000
	}

	handle {
		reverse_proxy frontend:3000
	}

	header {
		-Server
		-X-Powered-By
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}

	log {
		output stdout
		format json
	}
}

{$ADMIN_SITE_ADDRESS} {
	encode zstd gzip

	@admin_root path /
	redir @admin_root /admin/ 302

	@django_admin path /admin /admin/* /static/*
	handle @django_admin {
		reverse_proxy backend:8000
	}

	handle {
		respond "Not Found" 404
	}

	header {
		-Server
		-X-Powered-By
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}

	log {
		output stdout
		format json
	}
}

{$GLITCHTIP_DOMAIN} {
	encode zstd gzip

	reverse_proxy glitchtip:8000

	header {
		-Server
		-X-Powered-By
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}

	log {
		output stdout
		format json
	}
}

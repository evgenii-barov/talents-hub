# Django
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=change-me-before-using-outside-local-development
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000
ENABLE_API_DOCS=true

# API throttling. Production may tune these after observing real traffic.
DRF_ANON_THROTTLE_RATE=120/minute
DRF_USER_THROTTLE_RATE=600/minute
DRF_AUTH_THROTTLE_RATE=10/minute
DRF_ACCOUNT_EMAIL_THROTTLE_RATE=5/hour

# Local services
DATABASE_URL=postgresql://talents_hub:talents_hub@localhost:5433/talents_hub
REDIS_URL=redis://localhost:6379/1
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Email: console backend is safe for local development
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@localhost
FRONTEND_URL=http://localhost:3000
# Yandex Cloud Postbox (production): use a static access key for a service account
# with the postbox.sender role in the same folder as the verified domain.
# DJANGO_EMAIL_BACKEND=config.email_backends.YandexPostboxEmailBackend
# DEFAULT_FROM_EMAIL=Talents Hub <noreply@talents-hub.example>
# YANDEX_POSTBOX_ACCESS_KEY_ID=<Postbox_static_access_key_ID>
# YANDEX_POSTBOX_SECRET_KEY=<Postbox_static_secret_key>
# YANDEX_POSTBOX_ENDPOINT=https://postbox.cloud.yandex.net
# YANDEX_POSTBOX_REGION=ru-central1

# OAuth: register apps after the public HTTPS domain is available.
# Callback URLs are https://<backend-public-origin>/accounts/google/login/callback/
# and https://<backend-public-origin>/accounts/github/login/callback/
# Production defaults to SOCIAL_AUTH_ENABLED=false; enable foreign OAuth only where lawful.
SOCIAL_AUTH_ENABLED=true
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=

# Monitoring: leave SENTRY_DSN empty to disable the SDK locally.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_PROFILES_SAMPLE_RATE=0.0

# S3 storage is disabled locally. Enable only when credentials are configured.
USE_S3=false
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION_NAME=

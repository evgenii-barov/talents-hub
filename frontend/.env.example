# Public base URL of Django/DRF. The browser sends HttpOnly cookies with requests.
NEXT_PUBLIC_API_URL=http://localhost:8000/api
# Canonical public URL used in metadata, sitemap.xml and robots.txt.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional self-hosted Umami tracker. Analytics stays disabled until both values are configured
# and the visitor explicitly allows anonymous analytics.
NEXT_PUBLIC_UMAMI_SCRIPT_URL=http://insights.localhost/th.js
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
# API data is the source of truth. The frontend does not use mock catalogue records.
NEXT_PUBLIC_USE_MOCKS=false
